# Postgres – lokal: `npm run db:local` startet eine Instanz auf Port 5433
# Bei Neon: DATABASE_URL = gepoolte Verbindung, DIRECT_URL = direkte Verbindung
DATABASE_URL="postgresql://kdc:kdc@localhost:5433/kdc?schema=public"
DIRECT_URL="postgresql://kdc:kdc@localhost:5433/kdc?schema=public"

# Zufälliger Schlüssel für Sitzungen, z. B. `npx auth secret` oder `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Öffentliche Adresse der App (für Links in E-Mails)
APP_URL="http://localhost:3000"

# Optional: E-Mail-Versand über Resend (ohne Schlüssel werden Mails nur in der Konsole ausgegeben)
RESEND_API_KEY=""
MAIL_FROM="KDC Einsatzplanung <planung@example.com>"
